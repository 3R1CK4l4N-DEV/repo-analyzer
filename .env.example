# LLM provider: ollama | openai | anthropic
DEVANALYZER_LLM_PROVIDER=ollama
DEVANALYZER_LLM_MODEL=qwen2.5-coder:7b
DEVANALYZER_OLLAMA_HOST=http://localhost:11434

# Optional judge model for `rules extract --verify` (ideally different from the generator)
# DEVANALYZER_VERIFY_PROVIDER=ollama
# DEVANALYZER_VERIFY_MODEL=qwen3:8b

# Semantic embeddings for `devanalyzer index`, `search` and RAG context (ollama | openai)
# DEVANALYZER_EMBEDDING_PROVIDER=ollama
# DEVANALYZER_EMBEDDING_MODEL=nomic-embed-text

# Optional workspace path for multi-repo links (`devanalyzer workspace`)
# DEVANALYZER_WORKSPACE=

# Only needed for cloud providers (install extras: pip install -e ".[openai]" / ".[anthropic]")
# DEVANALYZER_OPENAI_API_KEY=
# DEVANALYZER_ANTHROPIC_API_KEY=

# Reader limits & output directory
DEVANALYZER_MAX_FILE_SIZE_KB=512
# DEVANALYZER_OUTPUT_DIR_NAME=.devanalyzer
